# Copier en `.env.prod` à la racine, jamais versionné. La pile de production le
# charge PAR-DESSUS le `.env`, le dernier l'emportant variable par variable :
#   docker compose -f compose.prod.yaml up -d --wait --wait-timeout 60

# Chaque ligne SURCHARGE le `.env`, sauf EMAIL_HOST et FRONTEND_URL, que seule la
# production lit et exige. Supprimée, une ligne ne retombe pas sur le défaut du
# code : elle hérite du `.env`.

# ⚠️ Aucune variable qu'un fichier Compose interpole (POSTGRES_*, VITE_API_URL, ports) :
# `env_file` ne nourrit que le conteneur. Déplacée ici, une `${VAR:?}` arrête le
# démarrage, une `${VAR:-défaut}` retombe en silence sur son défaut.

# Le caractère `$` y est proscrit comme dans le `.env` : Compose lit les deux.

# `postgres:17-alpine` ne sert pas de TLS, et le lien vers la base ne quitte jamais
# le réseau `interne`. Avec `require`, le backend refuse de démarrer ; y revenir dès
# que la base est ailleurs.
POSTGRES_SSLMODE=disable

# Légitime ICI seulement : le nginx du serveur ÉCRASE X-Forwarded-Proto (conf au
# README), et le backend n'écoute que sur `127.0.0.1`. À 0, la sonde reçoit la
# redirection HTTPS et le conteneur reste `unhealthy`.
DJANGO_BEHIND_PROXY=1

# VIDE, et la ligne doit rester : sans elle, la production hériterait des origines
# Vite du `.env`. Juste tant que le site et l'API partagent la même origine.
CORS_ALLOWED_ORIGINS=

# 0 tant que la pile est jointe sur `localhost` : un HSTS y vaut pour tous les ports
# et bloquerait Vite. Avec un vrai domaine : 3600, puis 86400, puis 31536000.
DJANGO_HSTS_SECONDS=0

# --- Emails ---
# Sans canal d'envoi, la réinitialisation répond quand même 200, pour ne pas
# trahir l'existence du compte, et personne ne reçoit de lien.

# Relais SMTP, EXIGÉ. `.env.example` le garde commenté : hérité de là-bas, un
# `localhost` ferait croire à l'envoi sans que rien n'échoue.
EMAIL_HOST=smtp.remplace-moi.fr

# Racine des liens des emails : l'adresse du front, sans barre finale. EXIGÉE pour
# la même raison : héritée, elle enverrait tous les destinataires sur `localhost`.
FRONTEND_URL=https://remplace-moi.fr

# Adresse expéditrice. Le défaut du code, `no-reply@weeb.local`, convient à
# Mailpit et se fait refuser par un relais réel : poser ici un domaine dont le
# relais accepte d'expédier.
DEFAULT_FROM_EMAIL=no-reply@remplace-moi.fr

# Port du relais, le 587 de STARTTLS. La ligne doit RESTER, comme celle de
# CORS_ALLOWED_ORIGINS : `.env.example` invite à y poser 1025 le jour où le port
# de Mailpit change, et la production hériterait alors de ce port-là.
EMAIL_PORT=587

# Délai de garde de l'envoi ; la ligne doit RESTER : baissé dans le `.env` pour un
# test, il serait hérité, et l'échec ne sortirait que dans les journaux.
EMAIL_TIMEOUT=10

# Identifiants du relais, à renseigner dans le `.env.prod` réel et NULLE PART
# ailleurs : ce modèle-ci est versionné. Vides = pas d'authentification.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# STARTTLS. La ligne doit RESTER pour la même raison, et l'enjeu est plus lourd :
# un `EMAIL_USE_TLS=0` posé dans le `.env` serait hérité ici, et identifiants
# comme messages partiraient en clair sans que rien ne le signale.
EMAIL_USE_TLS=1
