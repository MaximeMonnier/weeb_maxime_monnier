# Copier en `.env.prod`. Chargé après `.env`, il le surcharge : README, « Déployer ».
# Chaque ligne doit rester : supprimée, elle hérite du `.env`, réglé pour Mailpit.
# ⚠️ Ni `$`, ni variable que Compose interpole (base, ports, VITE_API_URL, IMAGE_TAG).

# La base ne sert pas de TLS et ne quitte pas le réseau `interne`.
POSTGRES_SSLMODE=disable
# Légitime seulement derrière le nginx du serveur, qui écrase X-Forwarded-Proto et X-Forwarded-For.
DJANGO_BEHIND_PROXY=1
# Vide exprès : site et API partagent la même origine.
CORS_ALLOWED_ORIGINS=
# 0 tant que la pile est jointe sur `localhost`.
DJANGO_HSTS_SECONDS=0
DJANGO_LOG_LEVEL=INFO

# --- Emails : les trois premières sont exigées ---
EMAIL_HOST=smtp.remplace-moi.fr
FRONTEND_URL=https://remplace-moi.fr
DJANGO_ADMINS=equipe@remplace-moi.fr
# Un domaine dont le relais accepte d'expédier.
DEFAULT_FROM_EMAIL=no-reply@remplace-moi.fr
EMAIL_PORT=587
EMAIL_TIMEOUT=10
# Les vrais identifiants vont dans `.env.prod` seul : ce modèle est versionné.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
