# ============================================
#  Backend — Python / Django
# ============================================

# Environnement virtuel : propre à ta machine, ne doit JAMAIS être versionné.
# (chacun le recrée avec : python3 -m venv venv + pip install -r requirements.txt)
venv/
backend/venv/

# Fichiers compilés par Python (cache), régénérés automatiquement.
__pycache__/
*.py[cod]

# Secrets : SECRET_KEY Django, identifiants de base de données, etc.
# NE JAMAIS committer un .env (sécurité).
.env
*.env

# Les fichiers par pile, `.env.prod` en tête : `*.env` ci-dessus ne les attrape
# pas, ils ne se TERMINENT pas par `.env`. Seuls les modèles en sont exclus —
# ils ne portent aucune valeur réelle et doivent partir avec le dépôt.
.env.*
!.env.example
!.env.*.example

# Fichiers statiques/médias collectés par Django (générés).
backend/staticfiles/
backend/media/

# ============================================
#  Proxy — certificats TLS
# ============================================
# Clé privée et certificat du terminateur TLS, produits par
# `proxy/generate-cert.sh`. Propres à chaque machine, jamais versionnés :
# une clé privée dans un dépôt est compromise dès le premier clone.
proxy/certs/

# ============================================
#  Divers / OS / IDE
# ============================================
.DS_Store
*.log
.idea/
.vscode/

# ============================================
#  Documents de travail internes — NE PAS committer
# ============================================
CLAUDE.md
GUIDE_RAPPORT.md
PROMPT_REECRITURE_RAPPORT.md
plan.md
# Configuration Claude Code : entièrement ignorée. Skills, commandes et réglages
# sont un outillage personnel, propre à la machine, et non un livrable du projet.
.claude/
