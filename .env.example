# Copier en `.env` à la racine, jamais versionné. Il liste chaque variable lue par
# Django et Compose, plus le port que suit Playwright ; le front a le sien,
# `frontend/.env.example`, Vite ne lisant que les `.env` de son propre dossier.

# DJANGO_SETTINGS_MODULE se pose dans l'environnement, pas ici : Django le lit avant
# ce fichier. Sur un serveur, la poser au service, sinon `manage.py migrate` tourne
# avec les réglages de développement.

# ⚠️ AUCUNE valeur ne doit contenir `$` : Compose la tronque là où python-dotenv la
# lit entière, et doubler le caractère ne fait que rendre le désaccord silencieux.
# Régénérer la valeur sans `$`, clé Django comprise.

# --- Django ---
# Une variable posée mais VIDE vaut « non renseignée » : le défaut s'applique.
# Pour désactiver quelque chose, écrire 0.

# Clé de signature, une PAR environnement : absente, le serveur refuse de démarrer.
# Pas get_random_secret_key(), dont l'alphabet contient `$` et `#`. En générer une :
#   python3 -c 'import secrets, string; print("".join(secrets.choice(string.ascii_letters + string.digits + "!@%^&*(-_=+)") for _ in range(50)))'
DJANGO_SECRET_KEY=remplace-moi-par-une-cle-generee

# Mode debug. Valeurs vraies : 1, true, yes, on. Vaut 0 partout sauf en
# développement, et reste faux d'office en production quoi qu'on mette ici.
DJANGO_DEBUG=1

# Hôtes que l'API accepte de servir, séparés par des virgules ; obligatoire en
# production. Garder 127.0.0.1 en conteneur : la sonde de santé l'interroge là, et
# un hôte non listé ferait déclarer malade un conteneur qui fonctionne.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Origines du FRONT autorisées par CORS, schéma et port compris, séparées par des
# virgules. Seulement celles du développement : `.env.prod` vide la variable, et
# doit la vider, sinon la production en hériterait.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Quotas de débit ---
# `<nombre>/<période>` par adresse IP sur les endpoints publics ; vide = défaut du
# code, rappelé sur chaque ligne. Compté par worker Gunicorn, donc jusqu'au triple.

# Connexion : fenêtre courte, pour ne pas punir qui se trompe deux fois. Compte les
# appels et non les échecs : le 6ᵉ de la minute vaut 429, même bon.
#THROTTLE_LOGIN=5/min

# Inscription, réinitialisation, contact : des gestes uniques. La réinitialisation
# est la plus basse, chacun de ses appels envoyant un vrai email.

#THROTTLE_REGISTER=5/hour
#THROTTLE_PASSWORD_RESET=3/hour
#THROTTLE_CONTACT=5/hour

# Confirmation du lien de réinitialisation : son propre compteur, pour ne pas
# entamer celui de la demande. Le quota borne le coût du hachage.
#THROTTLE_PASSWORD_RESET_CONFIRM=5/hour

# Changement de mot de passe : compté par compte et non par adresse IP, il borne
# qui devinerait le mot de passe actuel avec un jeton volé.
#THROTTLE_PASSWORD_CHANGE=5/hour

# --- Emails ---
# Commentées exprès : le développement prend les défauts du code, soit Mailpit.
# Activées, la production en hériterait : un EMAIL_HOST=localhost y passe sans erreur.

# Adresse expéditrice des messages, celle que verra le destinataire. Défaut du
# code : `no-reply@weeb.local`, bon pour Mailpit et refusé par tout relais réel.
#DEFAULT_FROM_EMAIL=no-reply@weeb.local

# Racine des liens écrits DANS les emails : l'adresse du front, sans barre finale.
# Commentée : activée, la production l'hériterait au lieu d'exiger la sienne.
#FRONTEND_URL=http://localhost:5173

# Relais SMTP, défauts `localhost` et `1025` ; à accorder si MAILPIT_SMTP_PORT_DEV change.
#EMAIL_HOST=localhost
#EMAIL_PORT=1025

# Délai de garde SMTP en secondes, 10 par défaut. Python n'en a aucun : sans lui,
# un relais muet immobilise le worker d'une vue publique.
#EMAIL_TIMEOUT=10

# Compte du relais, production seulement : les vrais identifiants vont dans `.env.prod`.
#EMAIL_HOST_USER=
#EMAIL_HOST_PASSWORD=

# STARTTLS, production seulement, 1 par défaut. Pour le couper, écrire 0 : vide, la
# variable vaut « non renseignée ».
#EMAIL_USE_TLS=1

# --- Production uniquement (ignorées ailleurs) ---
# Lues par `production.py` seul : elles gardent ici la valeur la plus SÛRE, celle du
# code. La pile Compose de production prend les siennes dans `.env.prod`.

# Chiffrement du lien à la base, `require` par défaut : sans lui, libpq se rabat en
# clair. `disable` seulement pour une base jointe en local ou par un tunnel chiffré,
# ce que fait `.env.prod` dans le réseau `interne` de Compose.
POSTGRES_SSLMODE=require

# 1 seulement derrière un proxy qui termine le TLS ET ÉCRASE X-Forwarded-Proto, sinon
# un client contournerait la redirection HTTPS. `.env.prod` pose 1 derrière le nginx
# du serveur (conf au README) ; 0 ici, pour un backend lancé sans rien devant.
DJANGO_BEHIND_PROXY=0

# HSTS, en secondes. Monter par paliers : 3600, 86400, puis 31536000, qui active le
# préchargement. 0 dans `.env.prod` : sur `localhost`, il bloquerait aussi Vite.
# Django ne le pose que sur ses réponses ; celles du front, au nginx (README).
DJANGO_HSTS_SECONDS=3600

# --- Base de données PostgreSQL ---
# Deux lecteurs : Django pour se connecter, Compose pour créer le conteneur `db` avec
# les trois premières. Un seul endroit à renseigner.

# Nom de la base et compte propriétaire. Créés au tout premier démarrage du
# conteneur, à partir de ces valeurs : les changer ensuite ne renomme rien
# dans un volume déjà initialisé, il faut un `down -v` sur la pile concernée.
POSTGRES_DB=weeb
POSTGRES_USER=weeb

# Mot de passe du compte, obligatoire. Lettres et chiffres seulement, à cause du `$`
# (voir en haut du fichier). En générer un :
#   python3 -c 'import secrets, string; a = string.ascii_letters + string.digits; print("".join(secrets.choice(a) for _ in range(32)))'
POSTGRES_PASSWORD=remplace-moi-par-un-mot-de-passe-genere

# La base vue du venv, par le port publié. Le backend en conteneur ignore cette
# ligne, Compose lui imposant `db:5432` : la laisser à `localhost`.
POSTGRES_HOST=localhost

# Port de la base sur la machine : Django s'y connecte depuis le venv, et
# Compose y publie le conteneur en développement. Le changer si un PostgreSQL
# occupe déjà 5432. Sans effet sur le port interne au réseau Compose.
POSTGRES_PORT=5432

# --- Docker Compose ---
# Lues par les fichiers Compose, FRONTEND_PORT_DEV aussi par Playwright. Django les
# reçoit dans le conteneur du backend et les ignore.

# Ports de la pile de DÉVELOPPEMENT côté machine ; dans le conteneur, 8000 et 5173.
# Déplacés, ils se reportent dans CORS_ALLOWED_ORIGINS et le VITE_API_URL de
# frontend/.env. Distincts de ceux de la production : les deux piles tournent ensemble.
BACKEND_PORT_DEV=8000
FRONTEND_PORT_DEV=5173

# Ports de Mailpit côté machine, développement seul ; dans le conteneur, 1025 et 8025.
# Le SMTP est publié pour le backend du venv. Interface : http://127.0.0.1:8025
MAILPIT_SMTP_PORT_DEV=1025
MAILPIT_UI_PORT_DEV=8025

# Ports de la pile de PRODUCTION, publiés sur `127.0.0.1` seul pour le nginx du
# serveur ; dans le conteneur, 8000 et 8080. Les faire coïncider avec ceux du
# développement vaut un `port is already allocated`.
BACKEND_PORT_PROD=8001
FRONTEND_PORT_PROD=8081

# Adresse de l'API écrite dans le bundle de l'image de production. Aussi dans
# frontend/.env, pour `npm run dev` : aucun des deux lecteurs ne voit l'autre fichier.
# Relative : le nginx sert site et API sur la même origine. Sans barre finale.
VITE_API_URL=/api
