# Copier en `.env`, jamais versionné. Détails : README, « Installation » et « Déployer ».
# ⚠️ Aucune valeur avec `$` : Compose la tronque, Django la lit entière.
# Vide = défaut du code ; pour désactiver, écrire 0.

# --- Django ---
# Une par environnement, sans `$` ni `#` : commande au README.
DJANGO_SECRET_KEY=remplace-moi-par-une-cle-generee
DJANGO_DEBUG=1
#DJANGO_LOG_LEVEL=INFO
# Garder 127.0.0.1 : la sonde de santé du conteneur l'interroge.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Quotas : défauts du code, README « Le débit » ---
#THROTTLE_LOGIN=5/min

#THROTTLE_REGISTER=5/hour
#THROTTLE_PASSWORD_RESET=3/hour
#THROTTLE_CONTACT=5/hour

#THROTTLE_PASSWORD_RESET_CONFIRM=5/hour
#THROTTLE_PASSWORD_CHANGE=5/hour
#THROTTLE_ACCOUNT_DELETE=5/hour

#THROTTLE_ARTICLE_WRITE=20/hour

# --- Emails : commentées exprès, la production en hériterait ---
#DEFAULT_FROM_EMAIL=no-reply@weeb.local
#FRONTEND_URL=http://localhost:5173

#DJANGO_ADMINS=equipe@weeb.local

#EMAIL_HOST=localhost
#EMAIL_PORT=1025
#EMAIL_TIMEOUT=10

#EMAIL_HOST_USER=
#EMAIL_HOST_PASSWORD=
#EMAIL_USE_TLS=1

# --- Production seule : valeurs les plus sûres, `.env.prod` pose les siennes ---
POSTGRES_SSLMODE=require
# 1 seulement derrière un proxy qui écrase X-Forwarded-Proto.
DJANGO_BEHIND_PROXY=0
DJANGO_HSTS_SECONDS=3600

# --- PostgreSQL ---
# Créés au premier démarrage : les changer ensuite exige un `down -v`.
POSTGRES_DB=weeb
POSTGRES_USER=weeb
# Lettres et chiffres seulement : commande au README.
POSTGRES_PASSWORD=remplace-moi-par-un-mot-de-passe-genere
# Vue du venv ; le backend en conteneur impose `db:5432`.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Ports sur 127.0.0.1, distincts entre dev et prod ---
# Port DEV déplacé, à reporter : backend → frontend/.env ; front → CORS_ALLOWED_ORIGINS
# et FRONTEND_URL ; SMTP → EMAIL_PORT.
BACKEND_PORT_DEV=8000
FRONTEND_PORT_DEV=5173
MAILPIT_SMTP_PORT_DEV=1025
MAILPIT_UI_PORT_DEV=8025
BACKEND_PORT_PROD=8001
FRONTEND_PORT_PROD=8081

# Front construit en local ; `npm run dev` lit celui de frontend/.env.
VITE_API_URL=/api
# SHA d'un commit de `main` ; vide = `latest`.
#IMAGE_TAG=
