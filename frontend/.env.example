# cp frontend/.env.example frontend/.env — Vite ne lit que les .env de ce dossier.
# Tout ce qui est préfixé VITE_ part EN CLAIR dans le bundle : aucun secret ici.
# Après modification, relancer Vite.

# Adresse de base de l'API Django, sans barre oblique finale. Absente, le front
# s'arrête au chargement. `localhost` vaut aussi en conteneur : c'est le
# navigateur qui appelle l'API, pas le serveur Vite.
VITE_API_URL=http://localhost:8000/api

# DEV_POLLING se pose dans le shell : vite.config.ts la lit dans process.env, où Vite
# ne verse aucun .env. À 1 quand les événements de fichiers ne remontent pas
# (conteneur, WSL2 sur /mnt/c) : DEV_POLLING=1 npm run dev

# E2E_EMAIL et E2E_PASSWORD aussi, Playwright ne chargeant aucun .env : un compte
# ACTIF de la base de développement, jamais écrit dans un fichier partagé.
#   E2E_EMAIL=... E2E_PASSWORD=... npm run test:e2e
