# Modèle de configuration du frontend :
#   cp frontend/.env.example frontend/.env
#
# Vite ne lit que les .env de frontend/, jamais celui de la racine. Tout ce qui
# est préfixé VITE_ part EN CLAIR dans le bundle : aucun secret ici.
# Après modification, relancer Vite.

# Adresse de base de l'API Django, sans barre oblique finale. Absente, le front
# s'arrête au chargement. `localhost` vaut aussi en conteneur : c'est le
# navigateur qui appelle l'API, pas le serveur Vite.
VITE_API_URL=http://localhost:8000/api
