# Docker n'utilise pas le .gitignore : sans ce fichier, node_modules/ partirait
# au démon à chaque build. Les chemins sont relatifs à frontend/.

# Réinstallé dans l'image depuis le verrou, et parfois compilé pour l'hôte.
node_modules/

# L'image de développement sert par Vite, jamais depuis dist/.
dist/
dist-ssr/

# Un .env entré dans un layer resterait lisible dans `docker history`. Le motif
# couvre .env.production et consorts, que Vite lit aussi.
.env*
*.local

# Ils décrivent l'image, ils ne la servent pas.
Dockerfile
.dockerignore

logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

.git/
.gitignore
.idea/
.vscode/
.DS_Store
